# Copie para .env ou exporte antes de subir o compose
# cp .env.stress .env

# Secrets (obrigatórios em production — mínimo 32 caracteres)
GOVOTE_JWT_SECRET=stress-jwt-secret-32chars-minimum!!
GOVOTE_CPF_PEPPER=stress-cpf-pepper-32chars-minimum!!

# Rate-limit elevado para conseguir estressar o sistema
GOVOTE_RATE_LIMIT_MAX=200
GOVOTE_RATE_LIMIT_WINDOW_SEC=60

# Totais e lockout mais permissivos em teste
GOVOTE_TOTAL_ELIGIBLE_VOTERS=50000
GOVOTE_LOCKOUT_MAX_FAILURES=20

# ID da enquete criada pelo setup-poll.sh (ajuste após criar)
POLL_ID=1

# Opcional: chave para endpoint Telegram (deixe vazio se não for usar)
GOVOTE_N8N_API_KEY=
