# Exemplo de variáveis para o modo Black Friday (docker-compose.bf.yaml)
# Copie para .env.bf e preencha. NÃO versione o .env.bf com valores reais.
#
# Gere os segredos com:  openssl rand -hex 32

# --- Segredos (obrigatórios; GOVOTE_REQUIRE_SECRETS=true exige >= 32 bytes) ---
GOVOTE_JWT_SECRET=troque-por-openssl-rand-hex-32
GOVOTE_CPF_PEPPER=troque-por-openssl-rand-hex-32

# --- Rate limit por IP (ajuste conforme a carga esperada) ---
GOVOTE_RATE_LIMIT_MAX=200
GOVOTE_RATE_LIMIT_WINDOW_SEC=60

# --- Estatística de comparecimento (turnout_pct em /admin/stats) ---
GOVOTE_TOTAL_ELIGIBLE_VOTERS=50000

# --- Integração n8n/Telegram (header X-API-Key). Vazio = endpoint desabilitado ---
GOVOTE_N8N_API_KEY=

# --- Usado pelo Justfile (receitas de stress/BF) ---
POLL_ID=1
