# --- Segredos (obrigatórios em produção) ---
# Gere com: openssl rand -hex 32
GOVOTE_JWT_SECRET=seu-valor-aleatorio-longo-aqui
GOVOTE_CPF_PEPPER=outro-valor-aleatorio-longo-aqui

# Exige secrets ≥ 32 bytes no boot (MustValidateSecrets)
GOVOTE_ENV=production
GOVOTE_REQUIRE_SECRETS=true

# --- Auth eleitor ---
GOVOTE_PASSCODE_TTL_MINUTES=10

# --- Integração n8n/Telegram ---
# Chave usada pelo n8n para chamar /integrations/telegram/request-code
# (header X-API-Key). Sem essa variável definida, o endpoint fica
# desabilitado (fail closed). Gere com: openssl rand -hex 32
GOVOTE_N8N_API_KEY=

# --- Bootstrap super-admin (só se a tabela admin estiver vazia) ---
GOVOTE_BOOTSTRAP_PHONE=+5511999999999
GOVOTE_BOOTSTRAP_USERNAME=super
GOVOTE_BOOTSTRAP_NAME=Super Admin

# --- Rate limit (IP) ---
GOVOTE_RATE_LIMIT_MAX=10
GOVOTE_RATE_LIMIT_WINDOW_SEC=60
# true só atrás de proxy confiável (nginx/Caddy/etc.)
GOVOTE_TRUST_PROXY_HEADERS=false

# --- Lockout por identidade (CPF / admin) ---
GOVOTE_LOCKOUT_MAX_FAILURES=5
GOVOTE_LOCKOUT_MINUTES=15

# --- HTTP ---
GOVOTE_MAX_BODY_BYTES=1048576
# Allowlist CORS (vírgula). Vazio = sem CORS (same-origin). Nunca use *
GOVOTE_CORS_ORIGINS=

# --- Stats (admin) ---
GOVOTE_TOTAL_ELIGIBLE_VOTERS=1000
